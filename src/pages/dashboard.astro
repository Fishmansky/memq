---
import AppLayout from "@/layouts/AppLayout.astro";
import SetCard from "@/components/app/SetCard.astro";
import CreateListForm from "@/components/app/CreateListForm";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);

const errorParam = Astro.url.searchParams.get("error");

// No is_system filter: al_select already restricts this to pre-built lists plus
// the caller's own, so dropping the filter is what makes custom lists visible
// without widening access.
let sets: { id: string; name: string; is_system: boolean }[] = [];
let queryError: string | null = null;
let bannerError: string | null = null;

if (supabase) {
  const { data, error } = await supabase
    .from("algorithm_lists")
    .select("id, name, is_system")
    .order("created_at", { ascending: true });

  if (error) {
    // Logged, not rendered. A PostgREST message names columns, tables, and
    // sometimes the policy that rejected the read — the same reason
    // createList.ts:57-61 returns a generic string. House rule for this repo:
    // server logs carry the detail, the browser gets a fixed message.
    console.error("dashboard: algorithm_lists query failed", error);
    queryError = "Could not load your sets. Try again.";
  } else {
    sets = data;
  }
}

const prebuiltSets = sets.filter((set) => set.is_system);
const myLists = sets.filter((set) => !set.is_system);

bannerError = errorParam ?? queryError;
---

<AppLayout title="Algorithm Sets">
  {
    bannerError && (
      <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
        {bannerError}
      </div>
    )
  }

  <section class="mb-10">
    <h2 class="mb-4 text-xl font-semibold text-white">Algorithm Sets</h2>
    {
      prebuiltSets.length === 0 && !queryError ? (
        <p class="text-blue-100/50">No pre-built sets found.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-3">
          {prebuiltSets.map((set) => (
            <SetCard id={set.id} name={set.name} />
          ))}
        </div>
      )
    }
  </section>

  <section>
    <h2 class="mb-4 text-xl font-semibold text-white">My Lists</h2>
    {
      myLists.length === 0 && !queryError ? (
        <p class="mb-6 text-blue-100/50">You don't have any lists yet. Create one to add your own algorithms.</p>
      ) : (
        <div class="mb-6 grid gap-4 sm:grid-cols-3">
          {myLists.map((set) => (
            <SetCard id={set.id} name={set.name} />
          ))}
        </div>
      )
    }
    <CreateListForm client:load />
  </section>
</AppLayout>
