# E2E sign-in credentials for Playwright's auth.setup.ts.
# Copy to .env.e2e (gitignored) and fill in a CONFIRMED user that exists in the
# Supabase project the preview server targets (the SUPABASE_URL in .dev.vars),
# NOT the local stack in .env.test.
#
# Create one via the app's /auth/signup (and confirm the email), or in the
# Supabase dashboard → Authentication → Users.

E2E_USERNAME=you@example.com
E2E_PASSWORD=your-password
