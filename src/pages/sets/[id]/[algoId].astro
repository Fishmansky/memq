---
import AppLayout from "@/layouts/AppLayout.astro";
import PracticeSession from "@/components/app/PracticeSession";
import ConfirmDelete from "@/components/app/ConfirmDelete";
import EditAlgorithmForm from "@/components/app/EditAlgorithmForm";
import { createClient } from "@/lib/supabase";

const { id, algoId } = Astro.params;

if (!id) {
  return Astro.redirect("/dashboard?error=" + encodeURIComponent("Set not found"));
}

if (!algoId) {
  return Astro.redirect(`/sets/${id}?error=` + encodeURIComponent("Algorithm not found"));
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

let algorithm: { id: string; name: string; moves: string } | null = null;
// `is_system` and `user_id` are selected so this page can derive the owner gate
// for its own delete control — the same gate sets/[id].astro applies.
let list: { id: string; name: string; is_system: boolean; user_id: string | null } | null = null;
let bannerError: string | null = null;

if (supabase) {
  // Neither query depends on the other's result, so they go out together
  // rather than costing two sequential round trips.
  const [{ data: algoData, error: algoError }, { data: listData, error: listError }] = await Promise.all([
    supabase.from("algorithms").select("id, name, moves").eq("id", algoId).eq("list_id", id).single(),
    supabase.from("algorithm_lists").select("id, name, is_system, user_id").eq("id", id).single(),
  ]);

  if (!algoError) {
    algorithm = algoData;
  } else {
    // Logged, not rendered — same house rule as dashboard.astro and
    // sets/[id].astro: a PostgREST message can name columns and policies.
    console.error("sets/[id]/[algoId]: algorithms query failed", algoError);
    bannerError = "Could not load this algorithm.";
  }

  if (!listError) {
    list = listData;
  } else {
    console.error("sets/[id]/[algoId]: algorithm_lists query failed", listError);
    bannerError ??= "Could not load this set.";
  }
}

if (!algorithm) {
  return Astro.redirect(`/sets/${id}` + "?error=" + encodeURIComponent("Algorithm not found"));
}

if (!list) {
  return Astro.redirect("/dashboard?error=" + encodeURIComponent("Set not found"));
}

// Owner-only, matching sets/[id].astro. RLS (alg_delete) enforces the write
// side; this only decides whether the control renders, so a pre-built entry
// shows nothing.
const canManageAlgorithm = !list.is_system && list.user_id === Astro.locals.user?.id;

const deletePrompt = `Delete "${algorithm.name}"? Its practice history will be permanently removed. This cannot be undone.`;
---

<AppLayout title={algorithm.name} backHref={`/sets/${list.id}`} backLabel={list.name}>
  {
    bannerError && (
      <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
        {bannerError}
      </div>
    )
  }
  <h1 class="mb-6 text-2xl font-bold text-white">{algorithm.name}</h1>
  <PracticeSession algorithmId={algorithm.id} moves={algorithm.moves} client:load />
  {
    canManageAlgorithm && (
      <div class="mt-10 border-t border-white/10 pt-6">
        <EditAlgorithmForm algorithmId={algorithm.id} name={algorithm.name} moves={algorithm.moves} client:load />
      </div>
    )
  }
  {
    canManageAlgorithm && (
      <div class="mt-8">
        <ConfirmDelete
          endpoint={`/api/algorithms/${algorithm.id}`}
          label="Delete algorithm"
          confirmPrompt={deletePrompt}
          redirectTo={`/sets/${list.id}`}
          client:load
        />
      </div>
    )
  }
</AppLayout>
