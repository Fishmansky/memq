{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memq",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "491c732a2b044c83b3ed24d6bbdef141"
    }
  ],
  "observability": {
    "enabled": true,
  },
  "routes": [
    { "pattern": "memq.proxilius.eu", "custom_domain": true }
  ],
}
