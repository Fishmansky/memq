# Integration-test DB credentials (copy to .env.test; .env.test is gitignored).
# Used by `npm run test:integration` (vitest.config.integration.ts).
#
# Start a local Supabase stack first:  npx supabase start
# The CLI prints the URL, the anon key, and the service_role key — paste below.
# Local defaults (anon/service_role keys are the well-known local-dev JWTs):

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<anon key from `npx supabase start`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npx supabase start`>
