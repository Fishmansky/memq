---
import AppLayout from "@/layouts/AppLayout.astro";
import MoveSequence from "@/components/app/MoveSequence.astro";
import { createClient } from "@/lib/supabase";

const { id, algoId } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let algorithm: { id: string; name: string; moves: string } | null = null;
let list: { id: string; name: string } | null = null;
let bannerError: string | null = null;

if (supabase) {
  const { data: algoData, error: algoError } = await supabase
    .from("algorithms")
    .select("id, name, moves")
    .eq("id", algoId)
    .single();

  if (!algoError) {
    algorithm = algoData;
  } else {
    bannerError = algoError.message;
  }

  const { data: listData, error: listError } = await supabase
    .from("algorithm_lists")
    .select("id, name")
    .eq("id", id)
    .single();

  if (!listError) {
    list = listData;
  } else {
    bannerError ??= listError.message;
  }
}

if (!algorithm) {
  return Astro.redirect("/sets/" + (id ?? "") + "?error=" + encodeURIComponent("Algorithm not found"));
}

if (!list) {
  return Astro.redirect("/dashboard?error=" + encodeURIComponent("Set not found"));
}
---

<AppLayout title={algorithm.name} backHref={`/sets/${list.id}`} backLabel={list.name}>
  {
    bannerError && (
      <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
        {bannerError}
      </div>
    )
  }
  <h1 class="mb-6 text-2xl font-bold text-white">{algorithm.name}</h1>
  <div class="mb-8">
    <MoveSequence moves={algorithm.moves} />
  </div>
  <button
    disabled
    class="cursor-not-allowed rounded-lg border border-white/10 bg-white/5 px-6 py-3 text-sm text-white/40 opacity-50"
  >
    Practice (coming soon)
  </button>
</AppLayout>
